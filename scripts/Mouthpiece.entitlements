<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for Mouthpiece.app (Developer ID, no sandbox).
     Only applied when signing with a real identity; see RELEASING.md for how each was checked. -->
<plist version="1.0">
<dict>
	<!-- Lip reading: AVFoundation capture. Without it the hardened runtime denies the camera
	     outright (no prompt), whatever NSCameraUsageDescription says. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Whisper mode: sounddevice/PortAudio mic input. Same rule as the camera. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
